# Copy to .env for local work. On Vercel, add the same names under Project Settings > Environment Variables.
# Never commit a real .env.

# Supabase project (Settings > API). The service key is secret: it bypasses row security.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Signs the login cookie. Any long random string; changing it signs everyone out.
SESSION_SECRET=
# Optional: how long a sign-in lasts, in hours (default 12).
SESSION_HOURS=

# The bearer token the scheduler sends to /api/cron/pull. Any long random string.
CRON_SECRET=

# Telegram scan notifications: the bot token from @BotFather. The group ID is saved on the Telegram settings page.
TELEGRAM_BOT_TOKEN=
